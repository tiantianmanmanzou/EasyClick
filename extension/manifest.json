{
  "name": "EasyClick",
  "short_name": "EasyClick",
  "version": "0.4.9",
  "description": "Open source browser design tools",
  "manifest_version": 3,
  "icons": {
    "16": "icons/visbug-16.png",
    "32": "icons/visbug-32.png",
    "48": "icons/visbug-48.png",
    "128": "icons/visbug-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "visbug.js",
    "type": "module"
  },
  "action": {
    "default_title": "Click or press shortcut key to launch EasyClick",
    "default_icon": {
      "16": "icons/visbug-16.png",
      "32": "icons/visbug-32.png",
      "48": "icons/visbug-48.png",
      "128": "icons/visbug-128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": [
      "tuts/*.gif",
      "toolbar/*"
    ],
    "matches": ["<all_urls>"]
  }],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Alt+Shift+D",
        "mac": "Alt+Shift+D",
        "chromeos": "Alt+Shift+D",
        "linux": "Alt+Shift+D"
      }
    }
  }
}
